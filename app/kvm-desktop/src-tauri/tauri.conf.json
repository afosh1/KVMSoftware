{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KVM Shared Workspace",
  "version": "0.1.0",
  "identifier": "dev.kvm.kvmshare",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ui dev",
    "beforeBuildCommand": "pnpm -C ui build"
  },
  "app": {
    "windows": [
      {
        "title": "KVM Shared Workspace",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Move your cursor between nearby laptops",
    "longDescription": "A secure, low-latency LAN virtual KVM: move the cursor across laptop screens to transfer control, share keyboard input, and sync the clipboard."
  }
}
